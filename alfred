#!/usr/bin/env python3
"""
alfred — CLI interativo de automação mobile BDD.

Uso interativo:  ./alfred
Uso direto:      ./alfred rodar | gravar <nome> | parar | status | ...
"""

import os
import re
import sys
import subprocess
import time
import tty
import termios
from pathlib import Path

ROOT = Path(__file__).parent
sys.path.insert(0, str(ROOT))

PID_FILE    = Path("/tmp/bdd_live_pid")
READY_FILE  = Path("/tmp/bdd_live_ready")
CMD_FILE    = Path("/tmp/bdd_live_cmd")
RESULT_FILE = Path("/tmp/bdd_live_result")

# ── Cores ANSI ────────────────────────────────────────────────────────────────
G  = "\033[0;32m"
Y  = "\033[0;33m"
C  = "\033[0;36m"
R  = "\033[0;31m"
B  = "\033[1m"
DIM = "\033[2m"
NC = "\033[0m"

def ok(msg):   print(f"  {G}✓{NC}  {msg}")
def err(msg):  print(f"  {R}✗{NC}  {msg}")
def info(msg): print(f"  {C}→{NC}  {msg}")
def warn(msg): print(f"  {Y}!{NC}  {msg}")


# ── Leitura de tecla única (sem Enter) ────────────────────────────────────────

def _is_tty():
    return sys.stdin.isatty()


def _getch():
    import select
    import os as _os
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        # Usa os.read(fd) direto — bypassa o buffer interno do Python
        # para que o select() enxergue corretamente os bytes das setas
        ch = _os.read(fd, 1).decode(errors="replace")
        if ch == "\x1b":
            # Setas chegam como \x1b[A/B/C/D quase simultaneamente.
            # ESC puro não tem bytes seguintes → timeout = volta ao menu.
            ready, _, _ = select.select([fd], [], [], 0.15)
            if not ready:
                return "\x1b"
            ch2 = _os.read(fd, 1).decode(errors="replace")
            ready2, _, _ = select.select([fd], [], [], 0.05)
            if not ready2:
                return f"\x1b{ch2}"
            ch3 = _os.read(fd, 1).decode(errors="replace")
            return f"\x1b{ch2}{ch3}"
        return ch
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def _prompt(msg, default=""):
    """Input simples com prompt colorido."""
    try:
        val = input(f"  {C}?{NC}  {msg}{f' [{default}]' if default else ''}: ").strip()
        return val or default
    except EOFError:
        return default


def _pause():
    """Aguarda Enter; ignora EOF em modo não-interativo."""
    try:
        input(f"\n  {DIM}Enter para continuar...{NC}")
    except EOFError:
        pass


# ── Menu interativo com setas ─────────────────────────────────────────────────

def _menu(titulo, opcoes, subtitulo=""):
    """
    Exibe menu navegável com ↑↓ e Enter (TTY) ou numerado (não-TTY).
    opcoes: lista de (label, valor)  |  separador: ("---", None)
    Retorna o valor da opção selecionada, ou None se ESC/q/0.
    """
    if not _is_tty():
        return _menu_numerado(titulo, opcoes, subtitulo)

    idx = 0
    while idx < len(opcoes) and opcoes[idx][1] is None:
        idx += 1

    while True:
        os.system("clear")
        _banner(titulo, subtitulo)

        for i, (label, val) in enumerate(opcoes):
            if val is None:
                print(f"  {DIM}──────────────────────────────{NC}")
            elif i == idx:
                print(f"  {B}{G}▶  {label}{NC}")
            else:
                print(f"     {label}")

        print(f"\n  {DIM}↑↓ navegar  Enter selecionar  ESC voltar{NC}")

        key = _getch()

        if key in ("\x1b[A", "k"):   # ↑
            idx -= 1
            while idx >= 0 and opcoes[idx][1] is None:
                idx -= 1
            if idx < 0:
                idx = len(opcoes) - 1
                while opcoes[idx][1] is None:
                    idx -= 1

        elif key in ("\x1b[B", "j"): # ↓
            idx += 1
            while idx < len(opcoes) and opcoes[idx][1] is None:
                idx += 1
            if idx >= len(opcoes):
                idx = 0
                while opcoes[idx][1] is None:
                    idx += 1

        elif key in ("\r", "\n"):
            return opcoes[idx][1]

        elif key in ("\x1b", "q"):
            return None


def _menu_numerado(titulo, opcoes, subtitulo=""):
    """Fallback para terminais não-interativos: seleção por número."""
    _banner(titulo, subtitulo)
    selecionaveis = [(i, label, val) for i, (label, val) in enumerate(opcoes) if val is not None]
    for n, (_, label, _) in enumerate(selecionaveis, 1):
        print(f"  {G}{n}.{NC}  {label}")
    print(f"  {DIM}0.  Voltar{NC}\n")
    try:
        try:
            escolha = input(f"  {C}?{NC}  Escolha: ").strip()
        except EOFError:
            return None
        n = int(escolha)
        if n == 0:
            return None
        return selecionaveis[n - 1][2]
    except (ValueError, IndexError):
        return None


def _banner(titulo, subtitulo=""):
    print(f"\n{B}{C}  ══════════════════════════════════{NC}")
    print(f"{B}    alfred — {titulo}{NC}")
    if subtitulo:
        print(f"  {DIM}  {subtitulo}{NC}")
    print(f"{C}  ══════════════════════════════════{NC}\n")


# ── Menu principal ─────────────────────────────────────────────────────────────

def menu_principal():
    while True:
        live_status = f"{G}ativo{NC}" if READY_FILE.exists() else f"{DIM}inativo{NC}"
        rec_status  = ""
        state_file  = Path("/tmp/bdd_recording_state")
        if state_file.exists():
            nome = state_file.read_text().strip()
            steps_file = Path("/tmp/bdd_recording_steps")
            n = len(steps_file.read_text().strip().splitlines()) if steps_file.exists() else 0
            rec_status = f"gravando: {Y}{nome}{NC} ({n} passos)"
        else:
            rec_status = f"{DIM}sem gravação ativa{NC}"

        subtitulo = f"live: {live_status}  |  {rec_status}"

        opcoes = [
            ("Gravar cenário",          "gravar"),
            ("Executar testes",         "rodar"),
            ("Execução paralela",       "paralelo"),
            ("---",                     None),
            ("Live runner",             "live"),
            ("Dispositivos",            "devices"),
            ("Verificar Appium",        "appium"),
            ("Screenshot",              "screenshot"),
            ("---",                     None),
            ("Sair",                    "sair"),
        ]

        escolha = _menu("Automação Mobile BDD", opcoes, subtitulo)

        if escolha is None or escolha == "sair":
            os.system("clear")
            print(f"\n  Até mais!\n")
            break
        elif escolha == "gravar":    menu_gravar()
        elif escolha == "rodar":     menu_rodar()
        elif escolha == "paralelo":  menu_paralelo()
        elif escolha == "live":      menu_live()
        elif escolha == "devices":   tela_devices()
        elif escolha == "appium":    tela_appium()
        elif escolha == "screenshot": tela_screenshot()


# ── Gravar ────────────────────────────────────────────────────────────────────

def menu_gravar():
    state_file = Path("/tmp/bdd_recording_state")

    while True:
        gravando = state_file.exists()
        nome = state_file.read_text().strip() if gravando else None
        steps_file = Path("/tmp/bdd_recording_steps")
        passos = steps_file.read_text().strip().splitlines() if (gravando and steps_file.exists()) else []

        if gravando:
            subtitulo = f"gravando: {nome}  ({len(passos)} passos)"
            opcoes = [
                ("Adicionar passo",     "passo"),
                ("Ver status",          "status"),
                ("Finalizar e salvar",  "parar"),
                ("---",                 None),
                ("Voltar",              None),
            ]
        else:
            subtitulo = "nenhuma gravação ativa"
            opcoes = [
                ("Iniciar nova gravação", "iniciar"),
                ("---",                   None),
                ("Voltar",                None),
            ]

        escolha = _menu("Gravar Cenário", opcoes, subtitulo)

        if escolha is None:
            return

        elif escolha == "iniciar":
            os.system("clear")
            _banner("Nova Gravação")
            nome = _prompt("Nome do cenário (ex: login_usuario)")
            if nome:
                from utils.recorder import cmd_start
                cmd_start(nome)
                _pause()

        elif escolha == "passo":
            os.system("clear")
            _banner("Adicionar Passo", f"cenário: {nome}")
            _mostrar_passos(passos)

            kw_opcoes = [
                ("Given  — pré-condição / estado inicial", "Given"),
                ("When   — ação do usuário",               "When"),
                ("Then   — verificação / resultado",       "Then"),
                ("And    — continuação do passo anterior", "And"),
                ("---",                                    None),
                ("Voltar",                                 None),
            ]
            kw = _menu("Keyword do passo", kw_opcoes)
            if kw is None:
                continue

            os.system("clear")
            _banner("Adicionar Passo", f"{kw}")
            desc = _prompt("Descrição do passo")
            if desc:
                from utils.recorder import cmd_step
                cmd_step(kw, desc)
                if READY_FILE.exists():
                    _executar_live(desc)
                _pause()

        elif escolha == "status":
            os.system("clear")
            _banner("Status da Gravação", nome)
            _mostrar_passos(passos)
            _pause()

        elif escolha == "parar":
            os.system("clear")
            _banner("Finalizar Gravação")
            from utils.recorder import cmd_stop
            cmd_stop()
            _pause()
            return


def _mostrar_passos(passos):
    if not passos:
        print(f"  {DIM}(nenhum passo ainda){NC}\n")
        return
    for i, s in enumerate(passos, 1):
        if "|" in s:
            kw, desc = s.split("|", 1)
            cor = {
                "Given": G, "When": C, "Then": Y, "And": DIM
            }.get(kw, NC)
            print(f"  {DIM}{i:02d}.{NC}  {cor}{kw}{NC}  {desc}")
    print()


def _executar_live(desc):
    CMD_FILE.write_text(desc)
    for _ in range(15):
        if RESULT_FILE.exists():
            result = RESULT_FILE.read_text().strip()
            RESULT_FILE.unlink(missing_ok=True)
            if result.startswith("ok"):
                ok(f"Executado no device")
            else:
                warn(f"Device: {result}")
            return
        time.sleep(0.5)
    warn("Live runner não respondeu.")


# ── Rodar ─────────────────────────────────────────────────────────────────────

def menu_rodar():
    features = sorted(ROOT.glob("features/**/*.feature"))
    opcoes = [("Todas as features", "__todas__")]
    for f in features:
        opcoes.append((str(f.relative_to(ROOT)), str(f)))
    opcoes += [("---", None), ("Voltar", None)]

    escolha = _menu("Executar Testes", opcoes, "escolha uma feature")
    if escolha is None:
        return

    plataforma_opcoes = [
        ("Detectar automaticamente", ""),
        ("iOS",                      "--platform ios"),
        ("Android",                  "--platform android"),
        ("---",                      None),
        ("Voltar",                   None),
    ]
    plat = _menu("Plataforma", plataforma_opcoes)
    if plat is None:
        return

    os.system("clear")
    _banner("Executando Testes")
    args = [] if escolha == "__todas__" else [escolha]
    if plat:
        args += plat.split()
    subprocess.run([str(ROOT / "run.sh")] + args, cwd=str(ROOT))
    _pause()


# ── Paralelo ──────────────────────────────────────────────────────────────────

def menu_paralelo():
    features = sorted(ROOT.glob("features/**/*.feature"))
    opcoes = [("Todas as features", "__todas__")]
    for f in features:
        opcoes.append((str(f.relative_to(ROOT)), str(f)))
    opcoes += [("---", None), ("Voltar", None)]

    escolha = _menu("Execução Paralela", opcoes, "iOS + Android simultâneo")
    if escolha is None:
        return

    os.system("clear")
    _banner("Execução Paralela", "iOS + Android")
    args = [] if escolha == "__todas__" else [escolha]
    subprocess.run([str(ROOT / "run-parallel.sh")] + args, cwd=str(ROOT))
    _pause()


# ── Live Runner ───────────────────────────────────────────────────────────────

def menu_live():
    while True:
        ativo = READY_FILE.exists() and PID_FILE.exists()
        pid   = PID_FILE.read_text().strip() if PID_FILE.exists() else "—"
        sub   = f"PID {pid} — {'sessão ativa' if ativo else 'parado'}"

        if ativo:
            opcoes = [
                ("Parar daemon",   "parar"),
                ("---",            None),
                ("Voltar",         None),
            ]
        else:
            opcoes = [
                ("Iniciar daemon", "iniciar"),
                ("---",            None),
                ("Voltar",         None),
            ]

        escolha = _menu("Live Runner", opcoes, sub)
        if escolha is None:
            return

        os.system("clear")
        _banner("Live Runner")

        if escolha == "iniciar":
            if READY_FILE.exists():
                warn("Daemon já está rodando.")
            else:
                log = Path("/tmp/bdd_live_runner.log")
                env = os.environ.copy()
                env["PYTHONUNBUFFERED"] = "1"
                proc = subprocess.Popen(
                    [sys.executable, "-m", "utils.live_runner"],
                    cwd=str(ROOT), env=env,
                    stdout=log.open("w"), stderr=subprocess.STDOUT,
                )
                info(f"Iniciando daemon (PID {proc.pid})...")
                for _ in range(30):
                    if READY_FILE.exists():
                        ok("Sessão Appium pronta.")
                        break
                    time.sleep(1)
                    print(".", end="", flush=True)
                else:
                    err("Timeout. Veja: /tmp/bdd_live_runner.log")

        elif escolha == "parar":
            if not PID_FILE.exists():
                warn("Nenhum daemon ativo.")
            else:
                CMD_FILE.write_text("STOP")
                info("Sinal enviado...")
                for _ in range(10):
                    if not PID_FILE.exists():
                        ok("Daemon encerrado.")
                        break
                    time.sleep(1)

        _pause()


# ── Devices ───────────────────────────────────────────────────────────────────

def tela_devices():
    os.system("clear")
    _banner("Dispositivos")

    print(f"  {B}iOS — Simuladores:{NC}")
    r = subprocess.run(
        ["xcrun", "simctl", "list", "devices", "booted"],
        capture_output=True, text=True
    )
    linhas = [l for l in r.stdout.splitlines() if l.strip() and "--" not in l]
    if linhas:
        for l in linhas:
            clean = re.sub(r"\([0-9A-F-]{36}\)", "", l, flags=re.I).strip()
            if clean and "==" not in clean:
                print(f"    {G}•{NC}  {clean}")
    else:
        print(f"    {DIM}(nenhum simulador ativo){NC}")

    print(f"\n  {B}Android — Devices:{NC}")
    r = subprocess.run(["adb", "devices"], capture_output=True, text=True)
    linhas = [l for l in r.stdout.splitlines()[1:] if l.strip()]
    if linhas:
        for l in linhas:
            print(f"    {G}•{NC}  {l.strip()}")
    else:
        print(f"    {DIM}(nenhum device conectado){NC}")

    print()
    _pause()


# ── Appium ────────────────────────────────────────────────────────────────────

def tela_appium():
    os.system("clear")
    _banner("Verificar Appium")
    try:
        r = subprocess.run(
            ["curl", "-s", "http://localhost:4723/status"],
            capture_output=True, text=True, timeout=5
        )
        if r.returncode == 0 and "ready" in r.stdout.lower():
            ok("Appium rodando em localhost:4723")
        else:
            err("Appium não está rodando.")
            info("Inicie com:  appium")
    except Exception:
        err("Não foi possível conectar ao Appium.")
    print()
    _pause()


# ── Screenshot ────────────────────────────────────────────────────────────────

def tela_screenshot():
    os.system("clear")
    _banner("Screenshot")
    if not READY_FILE.exists():
        err("Live runner não está ativo.")
        info("Inicie pelo menu  Live runner → Iniciar daemon")
        print()
        _pause()
        return

    CMD_FILE.write_text("tiro um screenshot")
    info("Capturando...")
    for _ in range(15):
        if RESULT_FILE.exists():
            result = RESULT_FILE.read_text().strip()
            RESULT_FILE.unlink(missing_ok=True)
            if result.startswith("ok"):
                ok("Screenshot salvo em automation_scripts/screenshots/")
            else:
                err(f"Erro: {result}")
            break
        time.sleep(1)
    else:
        err("Sem resposta do live runner.")
    print()
    _pause()


# ── Comandos diretos (modo não interativo) ────────────────────────────────────

def _cmd_direto(argv):
    from utils.recorder import cmd_start, cmd_step, cmd_status, cmd_stop

    cmd  = argv[0]
    rest = argv[1:]

    if cmd == "gravar":
        if not rest:
            err("Uso: alfred gravar <nome>"); sys.exit(1)
        cmd_start(rest[0])

    elif cmd == "passo":
        if len(rest) < 2:
            err("Uso: alfred passo <Given|When|Then|And> \"descrição\""); sys.exit(1)
        cmd_step(rest[0], " ".join(rest[1:]))

    elif cmd == "status":
        cmd_status()

    elif cmd == "parar":
        cmd_stop()

    elif cmd == "rodar":
        subprocess.run([str(ROOT / "run.sh")] + rest, cwd=str(ROOT))

    elif cmd == "paralelo":
        subprocess.run([str(ROOT / "run-parallel.sh")] + rest, cwd=str(ROOT))

    elif cmd == "live":
        sub = rest[0] if rest else "status"
        if sub == "iniciar":
            log = Path("/tmp/bdd_live_runner.log")
            env = os.environ.copy(); env["PYTHONUNBUFFERED"] = "1"
            proc = subprocess.Popen(
                [sys.executable, "-m", "utils.live_runner"],
                cwd=str(ROOT), env=env,
                stdout=log.open("w"), stderr=subprocess.STDOUT,
            )
            print(f"Iniciando (PID {proc.pid})...")
            for _ in range(30):
                if READY_FILE.exists():
                    ok("Sessão Appium pronta."); return
                time.sleep(1)
            err("Timeout.")
        elif sub == "parar":
            if PID_FILE.exists():
                CMD_FILE.write_text("STOP")
                ok("Sinal enviado.")
            else:
                warn("Nenhum daemon ativo.")
        else:
            if READY_FILE.exists() and PID_FILE.exists():
                ok(f"Live runner ativo (PID {PID_FILE.read_text().strip()})")
            else:
                info("Live runner não está rodando.")

    elif cmd == "devices":
        tela_devices()

    elif cmd == "appium":
        r = subprocess.run(["curl", "-s", "http://localhost:4723/status"],
                           capture_output=True, text=True, timeout=5)
        if r.returncode == 0 and "ready" in r.stdout.lower():
            ok("Appium rodando em localhost:4723")
        else:
            err("Appium não está rodando. Inicie com: appium")

    elif cmd == "screenshot":
        tela_screenshot()

    else:
        err(f"Comando desconhecido: '{cmd}'")
        info("Execute  ./alfred  para o menu interativo.")
        sys.exit(1)


# ── Entrypoint ────────────────────────────────────────────────────────────────

if __name__ == "__main__":
    if len(sys.argv) > 1:
        try:
            _cmd_direto(sys.argv[1:])
        except KeyboardInterrupt:
            print()
        except Exception as e:
            err(str(e)); sys.exit(1)
    else:
        try:
            menu_principal()
        except KeyboardInterrupt:
            os.system("clear")
            print("\n  Até mais!\n")
