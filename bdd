#!/usr/bin/env python3
"""
bdd — CLI de automação mobile BDD.

Uso:
    bdd gravar <nome>           Inicia gravação de um cenário
    bdd passo <keyword> <desc>  Adiciona um passo à gravação ativa
    bdd status                  Mostra o que foi gravado até agora
    bdd parar                   Finaliza gravação e salva o .feature
    bdd rodar [feature] [opts]  Executa testes (padrão: todas as features)
    bdd paralelo [feature]      Executa iOS + Android em paralelo
    bdd live iniciar            Inicia o daemon de execução ao vivo
    bdd live parar              Para o daemon ao vivo
    bdd live status             Verifica se o daemon está rodando
    bdd devices                 Lista simuladores iOS e devices Android
    bdd appium                  Verifica se o Appium está rodando
    bdd screenshot              Tira um screenshot avulso
"""

import os
import sys
import subprocess
import time
from pathlib import Path

ROOT = Path(__file__).parent
sys.path.insert(0, str(ROOT))

# ── Cores ANSI ────────────────────────────────────────────────────────────────
G  = "\033[0;32m"   # verde
Y  = "\033[0;33m"   # amarelo
C  = "\033[0;36m"   # ciano
R  = "\033[0;31m"   # vermelho
B  = "\033[1m"      # negrito
NC = "\033[0m"      # reset

PID_FILE   = Path("/tmp/bdd_live_pid")
READY_FILE = Path("/tmp/bdd_live_ready")
CMD_FILE   = Path("/tmp/bdd_live_cmd")
RESULT_FILE = Path("/tmp/bdd_live_result")


def ok(msg):  print(f"{G}✓{NC}  {msg}")
def err(msg): print(f"{R}✗{NC}  {msg}")
def info(msg): print(f"{C}→{NC}  {msg}")
def warn(msg): print(f"{Y}!{NC}  {msg}")


# ── Ajuda ─────────────────────────────────────────────────────────────────────

def cmd_help():
    print(f"""
{B}{C}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{NC}
{B}  bdd — Automação Mobile BDD{NC}
{C}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{NC}

{B}GRAVAÇÃO{NC}
  {G}bdd gravar <nome>{NC}              Inicia gravação de um cenário
  {G}bdd passo <keyword> <desc>{NC}     Adiciona passo (Given/When/Then/And)
  {G}bdd status{NC}                     Mostra passos gravados até agora
