  {G}bdd rodar --tags @smoke{NC}        Filtra por tag
  {G}bdd rodar --platform ios{NC}       Força plataforma iOS ou android
  {G}bdd paralelo{NC}                   Roda iOS + Android em paralelo
  {G}bdd paralelo <feature>{NC}         Paralelo em feature específica

{B}LIVE RUNNER (execução ao vivo durante gravação){NC}
  {G}bdd live iniciar{NC}               Inicia daemon Appium em background
  {G}bdd live parar{NC}                 Para o daemon
  {G}bdd live status{NC}                Verifica se está rodando

{B}DEVICE / AMBIENTE{NC}
  {G}bdd devices{NC}                    Lista simuladores iOS e devices Android
  {G}bdd appium{NC}                     Verifica se o Appium está rodando
  {G}bdd screenshot{NC}                 Tira screenshot avulso do device

{B}FEATURES DISPONÍVEIS{NC}""")
    _list_features()
    print(f"""
{C}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{NC}
""")


def _list_features():
    features = sorted(ROOT.glob("features/**/*.feature"))
    if not features:
        print("  (nenhuma feature encontrada)")
        return
    for f in features:
        rel = f.relative_to(ROOT)
        print(f"  {Y}•{NC} {rel}")


# ── Gravação ──────────────────────────────────────────────────────────────────

def cmd_gravar(args):
    if not args:
        err("Informe o nome do cenário. Ex: bdd gravar login_usuario")
        sys.exit(1)
    from utils.recorder import cmd_start
    cmd_start(args[0])


def cmd_passo(args):
    if len(args) < 2:
        err("Uso: bdd passo <Given|When|Then|And> \"descrição\"")
        sys.exit(1)
    from utils.recorder import cmd_step
    cmd_step(args[0], " ".join(args[1:]))


def cmd_status():
    from utils.recorder import cmd_status as _status
    _status()


def cmd_parar():
    from utils.recorder import cmd_stop
    cmd_stop()


# ── Execução ──────────────────────────────────────────────────────────────────

def cmd_rodar(args):
    _run_script("run.sh", args)


def cmd_paralelo(args):
    _run_script("run-parallel.sh", args)


def _run_script(script, args):
    cmd = [str(ROOT / script)] + args
    try:
        subprocess.run(cmd, cwd=str(ROOT))
    except KeyboardInterrupt:
        pass


# ── Live Runner ───────────────────────────────────────────────────────────────

def cmd_live(args):
    sub = args[0] if args else "status"

    if sub == "iniciar":
        if READY_FILE.exists():
            warn("Daemon já está rodando.")
            _live_show_status()
            return
        log = Path("/tmp/bdd_live_runner.log")
        env = os.environ.copy()
        env["PYTHONUNBUFFERED"] = "1"
        proc = subprocess.Popen(
            [sys.executable, "-m", "utils.live_runner"],
            cwd=str(ROOT),
            env=env,
            stdout=log.open("w"),
            stderr=subprocess.STDOUT,
        )
        info(f"Iniciando daemon (PID {proc.pid})...")
        for _ in range(30):
            if READY_FILE.exists():
                ok("Live runner pronto — sessão Appium ativa.")
                return
            time.sleep(1)
        err("Timeout aguardando sessão Appium. Verifique o log: /tmp/bdd_live_runner.log")

    elif sub == "parar":
        if not PID_FILE.exists():
            warn("Nenhum daemon ativo.")
            return
        CMD_FILE.write_text("STOP")
        info("Sinal de parada enviado.")
        for _ in range(10):
            if not PID_FILE.exists():
                ok("Daemon encerrado.")
                return
            time.sleep(1)
        warn("Daemon não respondeu — pode já ter encerrado.")

    elif sub == "status":
        _live_show_status()

    else:
        err(f"Subcomando desconhecido: {sub}. Use: iniciar | parar | status")


def _live_show_status():
    if READY_FILE.exists() and PID_FILE.exists():
        pid = PID_FILE.read_text().strip()
        ok(f"Live runner ativo (PID {pid}) — sessão Appium pronta.")
    elif PID_FILE.exists():
        warn("Processo existe mas sessão ainda não está pronta.")
    else:
        info("Live runner não está rodando.")


# ── Devices ───────────────────────────────────────────────────────────────────

def cmd_devices():
    print(f"\n{B}iOS — Simuladores:{NC}")
    r = subprocess.run(
        ["xcrun", "simctl", "list", "devices", "booted"],
        capture_output=True, text=True
    )
    lines = [l for l in r.stdout.splitlines() if "--" not in l and l.strip()]
    if lines:
        import re
        for l in lines:
            # Remove UDID e cabeçalhos do simctl
            clean = re.sub(r"\([0-9A-F-]{36}\)", "", l, flags=re.I).strip()
            if clean and "==" not in clean:
                print(f"  {G}•{NC} {clean}")
    else:
        print("  (nenhum simulador ativo)")

    print(f"\n{B}Android — Devices:{NC}")
    r = subprocess.run(["adb", "devices"], capture_output=True, text=True)
    lines = [l for l in r.stdout.splitlines()[1:] if l.strip()]
    if lines:
        for l in lines:
            print(f"  {G}•{NC} {l.strip()}")
    else:
        print("  (nenhum device conectado)")
    print()


# ── Appium ────────────────────────────────────────────────────────────────────

def cmd_appium():
    r = subprocess.run(
        ["curl", "-s", "http://localhost:4723/status"],
        capture_output=True, text=True, timeout=5
    )
    if r.returncode == 0 and "ready" in r.stdout.lower():
        ok("Appium rodando em localhost:4723")
    else:
        err("Appium não está rodando. Inicie com: appium")


# ── Screenshot avulso ─────────────────────────────────────────────────────────

def cmd_screenshot():
    if not READY_FILE.exists():
        err("Live runner não está ativo. Inicie com: bdd live iniciar")
        sys.exit(1)
    CMD_FILE.write_text("tiro um screenshot")
    info("Capturando screenshot...")
    for _ in range(15):
        if RESULT_FILE.exists():
            result = RESULT_FILE.read_text().strip()
            RESULT_FILE.unlink(missing_ok=True)
            if result.startswith("ok"):
                ok("Screenshot salvo em automation_scripts/screenshots/")
            else:
                err(f"Erro: {result}")
            return
        time.sleep(1)
    err("Sem resposta do live runner.")


# ── Dispatch ──────────────────────────────────────────────────────────────────

COMMANDS = {
    "gravar":   cmd_gravar,
    "passo":    cmd_passo,
    "status":   lambda _=None: cmd_status(),
    "parar":    lambda _=None: cmd_parar(),
    "rodar":    cmd_rodar,
    "paralelo": cmd_paralelo,
    "live":     cmd_live,
    "devices":  lambda _=None: cmd_devices(),
    "appium":   lambda _=None: cmd_appium(),
    "screenshot": lambda _=None: cmd_screenshot(),
    "ajuda":    lambda _=None: cmd_help(),
    "--help":   lambda _=None: cmd_help(),
    "-h":       lambda _=None: cmd_help(),
}

if __name__ == "__main__":
    argv = sys.argv[1:]
    if not argv:
        cmd_help()
        sys.exit(0)

    cmd = argv[0]
    rest = argv[1:]

    if cmd not in COMMANDS:
        err(f"Comando desconhecido: '{cmd}'")
        info("Use 'bdd' ou 'bdd ajuda' para ver os comandos disponíveis.")
        sys.exit(1)

    fn = COMMANDS[cmd]
    try:
        sig = fn.__code__.co_varnames[:fn.__code__.co_argcount]
        if sig and sig[0] != "self":
            fn(rest)
        else:
            fn()
    except SystemExit:
        raise
    except KeyboardInterrupt:
        print()
    except Exception as e:
        err(str(e))
        sys.exit(1)
